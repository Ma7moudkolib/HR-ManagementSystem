# ─────────────────────────────────────────────
# Stage 1: Restore dependencies (shared cache)
# ─────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS restore

WORKDIR /src

COPY Backend/src/*.sln ./
COPY Backend/src/CompanyEmployees/*.csproj                  ./CompanyEmployees/
COPY Backend/src/CompanyEmployees.Presentation/*.csproj     ./CompanyEmployees.Presentation/
COPY Backend/src/CompanyEmployees.Tests/*.csproj            ./CompanyEmployees.Tests/
COPY Backend/src/Contracts/*.csproj                         ./Contracts/
COPY Backend/src/Entities/*.csproj                          ./Entities/
COPY Backend/src/Repository/*.csproj                        ./Repository/
COPY Backend/src/Service/*.csproj                           ./Service/
COPY Backend/src/Service.Contracts/*.csproj                 ./Service.Contracts/
COPY Backend/src/LoggerService/*.csproj                     ./LoggerService/
COPY Backend/src/Shared/*.csproj                            ./Shared/

RUN dotnet restore *.sln

COPY Backend/src/ .

# ─────────────────────────────────────────────
# Stage 2: Build — restore + publish together
# ─────────────────────────────────────────────
FROM restore AS build


RUN dotnet publish ./CompanyEmployees/CompanyEmployees.csproj \
    -c Release \
    -o /app/publish

# ─────────────────────────────────────────────
# Stage 3: Development
# ─────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS development

WORKDIR /src

COPY --from=restore /root/.nuget /root/.nuget
COPY --from=restore /src .

EXPOSE 8080

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Development
ENV DOTNET_USE_POLLING_FILE_WATCHER=true
ENV DOTNET_WATCH_RESTART_ON_RUDE_EDIT=true

ENTRYPOINT ["dotnet", "watch", "--project", "CompanyEmployees/CompanyEmployees.csproj", "run", "--no-launch-profile"]

# ─────────────────────────────────────────────
# Stage 4: Production
# ─────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS production

WORKDIR /app

COPY --from=build /app/publish .

EXPOSE 8080

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

ENTRYPOINT ["dotnet", "CompanyEmployees.dll"]